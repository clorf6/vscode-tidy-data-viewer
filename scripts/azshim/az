#!/bin/bash
# Stand-in for `az account get-access-token --output json --resource R` (what @azure/identity's AzureCliCredential
# runs): fetches the token from the Azure Developer CLI login instead and prints it in Azure CLI's JSON shape.
res=""
while [ $# -gt 0 ]; do
  case "$1" in
    --resource) res="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$res" ] || { echo "only 'account get-access-token --resource' is supported" >&2; exit 1; }
AZD_COLLECT_TELEMETRY=no "$HOME/.local/bin/azd" auth token --scope "${res%/}/.default" --output json |
  python3 -c '
import json, sys
from datetime import datetime
d = json.load(sys.stdin)
ts = int(datetime.fromisoformat(d["expiresOn"].replace("Z", "+00:00")).timestamp())
print(json.dumps({"accessToken": d["token"], "expiresOn": d["expiresOn"], "expires_on": ts, "tokenType": "Bearer"}))'
